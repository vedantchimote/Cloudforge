# CloudForge Production Environment Variables
# 
# CRITICAL: DO NOT commit this file with actual values to version control!
# Copy this file to .env.production and fill in the actual values.
# Add .env.production to .gitignore

# ============================================================================
# JWT Configuration (CRITICAL)
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_FROM_COMMAND_ABOVE

# ============================================================================
# Database Passwords (CRITICAL)
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# PostgreSQL
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# MongoDB
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# LDAP
LDAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
LDAP_CONFIG_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
LDAP_READONLY_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# ============================================================================
# Application URLs (Update for production)
# ============================================================================
FRONTEND_URL=https://your-domain.com
API_GATEWAY_URL=https://api.your-domain.com

# ============================================================================
# CORS Configuration
# ============================================================================
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================================================
# SSL/TLS Configuration
# ============================================================================
SSL_KEYSTORE_PASSWORD=changeit
JWT_EXPIRATION=3600000  # 1 hour in milliseconds (production)

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# ============================================================================
# Payment Gateway (Razorpay)
# ============================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# ============================================================================
# Monitoring & Logging
# ============================================================================
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGGING=false

# ============================================================================
# Service Discovery
# ============================================================================
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

